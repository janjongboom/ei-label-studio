# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SAM image staging (predict route fallback when no Vercel Blob token)
/public/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling
.claude/
.env*.local

# python virtual environments
.venv*/
venv*/
__pycache__/
*.pyc

# scratch and logs
/logs.txt
/scratch/

.pnpm-store/
